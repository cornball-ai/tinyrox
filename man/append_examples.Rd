\name{append_examples}
\alias{append_examples}
\title{Add Example Code to What a Block Already Has}
\usage{
append_examples(existing, code)
}
\arguments{
\item{existing}{Examples collected so far, or NULL.}

\item{code}{Example code to add.}
}
\value{
The combined examples text.
}
\description{
A block can carry several example tags (plain and conditional); they
all go on the one page, in the order written.
}
\keyword{internal}
